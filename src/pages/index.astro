---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import "../stylesheets/style.css";
---

<Layout>
    <div class="container">
        <Header />
        <div class="nameboard" style="display:flex">
            <span id="name">Matic Jurač</span><span id="alias"
                >a.k.a. mjura</span
            >
        </div>
        <div class="about">
            <p>Slovenia based Bioinformatics student, DevOps Engineer and Backend Software developer with 10 months of development experience.</p>
        </div>
        <div class="projects">
            <h3>Projects</h3>
            <ul>
                <li>
                    <a
                        href="https://github.com/rv2-best/studentski-predmetnik-app"
                        >Študentski predmetnik</a
                    >
                    <sub class="tech"> leadership, GitHub Actions, Docker</sub>
                    <p>
                        I was the project lead and infra/DevOps engineer at a
                        project with 14 other students. We created a
                        note-sharing and professor-rating platform for students
                        all around the world.
                    </p>
                </li>
                <li>
                    <a href="https://github.com/Nepozorni/Nepozorni-Main"
                        >Nepozorni</a
                    >
                    <sub class="tech"
                        >Ultralytics, Unity, CI/CD, tkinter, python</sub
                    >
                    <p>
                        As part of my studies, I was expected to create a final
                        project. Since I had taken courses on machine learning
                        with autonomous driving, I worked with two collaborators
                        to create a system which determines the attentiveness of
                        a driver using machine learning and will notify them if
                        they're not being attentive.
                    </p>
                </li>
            </ul>
        </div>
        <div class="projects">
            <h3>Experience</h3>
            <h4>Internship at <a href="https://www.troia.eu/en">Troia</a></h4>
            <dl>
                <dt>Proxmox</dt>
                <dd>
                    I worked with the DevOps/Infrastructure team to install proxmox on new nodes, create virtual machines, mass migrations of proxmox environments between nodes.
                    Node upgrades (PVE 6 → PVE 9)
                </dd>
                <dt>Python, Jython, RestAPI, SOAP API</dt>
                <dd>
                    Before I shifted towards the infrastructure side of development, I worked as a general software developer. I wrote python scripts (database querying and API) and jython Maximo automation scripts for updating asset data with launch points on data update for clients.
                </dd>
                <dt>Oracle DB, Microsoft SQL Server</dt>
                <dd>
                    My first big project in infrastructure/DevOps was database migration after IBM discontinued support for SQL server in newer MAS versions. We used the script unlcvt.sh to move database definitions to OracleDB and migrated data post-hoc.
                </dd>
                <dt>IBM Maximo 7.6.2, IBM MAS 9.0+</dt>
                <dd>
                    I installed new IBM Maximo Manage 9 instances, creating NFS servers and RedHat OpenShift containerization platforms.
                </dd>
            </dl>
        </div>
        <div class="education">
            <h3>Education</h3>
            <ul>
                <li>
                    University of Ljubljana - Ljubljana, Slovenia (Sept 2026 - Ongoing)
                    <ul>
                        <li>Masters degree in Bioinformatics</li>
                    </ul>
                </li>
                <li>
                    University of Maribor - Maribor, Slovenia (Oct 2023 - Aug 2026)
                    <ul>
                        <li>Undergraduate degree in Computer Engineering</li>
                    </ul>
                </li>
                <li>
                    Ravne High School - Ravne na Koroškem, Slovenia (Sept 2020 - Jun 2023)
                    <ul>
                        <li>High school diploma</li>
                        <li>Golden Graduate</li>
                    </ul>
                </li>
                <li>
                    High School of Chemistry, Electrotechnics and Computer
                    Science - Celje, Slovenia (2019 - 2020)
                </li>
            </ul>
        </div>
        <div class="contact">
            <h3>Contact & links</h3>
            <ul class="links">
                <li>
                    <a
                        href="mailto:bWF0aWMuZGV2ZWxvcGVyQHByb3Rvbi5tZQ"
                        onclick="this.href='mailto:'+atob('bWF0aWMuZGV2ZWxvcGVyQHByb3Rvbi5tZQ'); setTimeout(() => this.href='mailto:bWF0aWMuZGV2ZWxvcGVyQHByb3Rvbi5tZQ', 200);return true;"
                    >
                        E-Mail
                    </a>
                </li>
                <li>
                  <a href="https://github.com/mjura1" target="_blank">GitHub</a>
                </li> 
            </ul>
        </div>
    </div>
</Layout>

<style>
    .container {
        max-width: 40vw;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        vertical-align: middle;
        text-align: left;
        text-shadow: 0.5rem;
        font-size: 1rem;
    }

    .nameboard {
        padding: 2rem 0 0 0;
        display: flex;
        align-items: flex-end;
    }

    #name {
        font-size: 1.1rem;
        margin-right: 1.5rem;
        line-height: 1;
    }

    #alias {
        color: grey;
        font-style: italic;
        font-size: 0.9rem;
        padding-bottom: 0;
        margin-bottom: 0;
    }

    .about {
        text-align: justify;
    }

    .links {
        list-style-type: none;
        padding-left: 0;
    }

    .links > li {
        display: inline-block;
        margin-right: 1rem;
    }
    .tech {
        color: grey;
    }

    @media only screen and (max-width: 1000px) {
        .container {
            max-width: 80vh;
            margin: 0 auto;
            padding: 2rem 1.5rem;
            vertical-align: middle;
            text-align: left;
            text-shadow: 0.5rem;
            font-size: 1rem;
        }

        .tech {
            display: block;
            margin-top: 0.5rem;
            margin-left: 0;
        }
    }
</style>
